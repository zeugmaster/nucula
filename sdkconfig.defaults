# Reference board is Nucula v2 (ESP32-C3); without this a fresh clone builds
# for the default esp32 target (the pinned target otherwise lives only in
# the untracked sdkconfig).
CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Size optimization: -Os instead of -Og saves ~100-150KB
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# We only need STA mode with personal/open auth, disable SoftAP & Enterprise
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Disable IPv6 and unused DHCP server (SoftAP is off)
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n

# Reduce socket and PCB limits to match active client usage
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=2
CONFIG_LWIP_MAX_UDP_PCBS=6
CONFIG_LWIP_MAX_RAW_PCBS=2

# I2C master ISR in IRAM for reliable NFC communication
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=y

# Task telemetry for the console 'tasks' command (stack high-water marks)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# 1 kHz tick: vTaskDelay(pdMS_TO_TICKS(1)) really is 1 ms, not a 10 ms
# tick. Matters for keypad scans holding the shared I2C bus and NCI
# pacing. Tick ISR cost at 1 kHz is ~0.3% CPU.
CONFIG_FREERTOS_HZ=1000

# Quiet production logging: default WARN at runtime, but INFO strings stay
# compiled in so the console 'log i <tag>' command can re-enable them.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Memory-constrained TLS. By default each HTTPS connection allocates two
# ~16 KB mbedTLS content buffers up front, which must each be contiguous.
# Once the heap is fragmented by cached mint keysets the swap-POST handshake
# can no longer get them and fails with "PK verify failed / signature
# verification failed". Dynamic buffers size the RX buffer to the actual TLS
# record and free the CA bundle + SSL config after the handshake, cutting the
# peak contiguous demand dramatically.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Client-only TLS: drop unused server code, peer-cert retention (~4 KB/slot),
# unused X.509/PEM/PKCS7 parsers, and non-web EC curves (Cashu uses libsecp256k1).
# Enable fixed-point comb optimization for faster cold TLS ECDHE handshakes.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# TLS session tickets: a reconnect to a mint resumes the session instead of
# paying the full handshake + cert-chain verification again. Tickets live
# inside the cached esp_http_client handles (http.c connection cache).
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# Native USB console avoids UART0 RX on GPIO20 (keyboard INT_N on v2).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
